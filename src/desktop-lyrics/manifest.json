{
    "name": "桌面歌词",
    "ver": "1.0.3",
    "desc": "将歌词显示在桌面上",
    "author": "LUOLEYAN",
    "entry": "index.js",
    "id": "23dc60b0-4621-4ab3-92f7-50baf8b6ec1a",
    "settings": "settings.js",

    "components": [
        "audio_player",
        "playlist",
        "new_window",
        "store"
    ],

    "windows": {
        "desktop-lyrics": {
            "openDevTools": false,
            "openOptions": {
                "width": 720,
                "height": 240,
                "alwaysOnTop": true,
                "frame": false,
                "transparent": true,
                "backgroundColor": "#00000000",
                "hasShadow": false,
                "maximizable": false,
                "minimizable": false,
                "skipTaskbar": true,
                "resizable": false
            },
            "main": "./main.js",
            "renderer": "./renderer/index.html"
        }
    }
}
